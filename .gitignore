# --- Documentation build artifacts -------------------------------------
# docs/ is generated by tools/sync_docs.py. Never commit it; edit the
# originals in "Claude outputs/" instead.
docs/
site/
.cache/

# --- Large binaries ----------------------------------------------------
# "CCH chat webprint.pdf" alone is ~22 MB. GitHub warns above 50 MB and
# hard-rejects at 100 MB; more importantly, binaries bloat the repo forever
# because git keeps every version. Keep PDFs local.
*.pdf

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Data and outputs --------------------------------------------------
# data/ is private (source data, not ours to redistribute) and large — the Nepal
# daily rainfall workbook alone is ~29 MB. The repo is public and git history is
# permanent, so this stays excluded regardless of size. Keep your own backup.
data/
# outputs/
*.nc
*.hdf5
*.h5

# --- SPH / DualSPHysics run output -------------------------------------
*.bi4
*.vtk
*.vtu
CaseOut/

# --- Claude Code local state -------------------------------------------
# Machine-local permission settings; not useful to anyone else, and public.
.claude/settings.local.json

# --- Editors and OS ----------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
